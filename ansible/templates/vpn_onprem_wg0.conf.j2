# 작성자: 이유빈
# 작성 내용: 온프레미스 VPN 공개 설정 후보
# 개인키는 별도 보호 파일에서 읽습니다.
# 키 공급과 방화벽 준비 전에는 실제 실행하지 않습니다.
[Interface]
Address = {{ vpn_wireguard_onprem_tunnel_address }}
ListenPort = {{ vpn_wireguard_listen_port }}
MTU = {{ vpn_wireguard_mtu }}
SaveConfig = false
# 확인한 1.0.20210914 설치본은 PreUp이 장치 생성 전이므로 PostUp에서 개인키를 주입합니다.
PostUp = /usr/bin/wg set %i private-key /etc/wireguard/keys/%i.key

[Peer]
PublicKey = {{ vpn_wireguard_aws_public_key }}
AllowedIPs = {{ vpn_wireguard_aws_allowed_ips | join(', ') }}
Endpoint = {{ vpn_wireguard_aws_public_endpoint }}:{{ vpn_wireguard_listen_port }}
PersistentKeepalive = {{ vpn_wireguard_onprem_keepalive_seconds }}
