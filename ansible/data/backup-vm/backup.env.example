# /etc/seokpan-hybrid-backup/backup.env (root 600) — 백업 작업 VM hybrid-backup-01
# 비밀값은 넣지 않는다. DB 접속 정보는 SOURCE_CNF 파일, AWS 키는 AWS_PROFILE에 둔다.

# DB 접속 파일 (저장소에 넣지 않음)
#   Apply 전 예행: 1차 Replica db_admin 시험용 — 예행이 끝나면 삭제
#   Apply 후 운영: backup_dump@RDS, TLS(ssl-ca = 서울 번들 ap-northeast-2-bundle.pem)
SOURCE_CNF=/etc/seokpan-hybrid-backup/source.cnf

# Backup S3 버킷 이름 — foundation Apply 후 Data 출력값. 비어 있으면 S3를 건너뛰고 PARTIAL로 기록
S3_BUCKET=

# Backup User 키를 넣는 AWS CLI 프로필 (Apply 후 키 발급, Terraform 밖)
AWS_PROFILE=seokpan-backup

# 사본을 받는 복구 DB VM (sp-copy 계정 · 강제 명령 seokpan-recv-copy)
COPY_HOST=192.168.54.60

# Backup ID 앞부분이자 S3 경로. 운영 periodic / 예행 rehearsal
ID_PREFIX=periodic

# 로컬 사본 보관 일수 (03 문서 7일 보관)
KEEP_DAYS=7
